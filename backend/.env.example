# Copy to backend/.env and fill in. Never commit the real file.

# Port the API listens on.
PORT=4000

# Required for every write: saving prices, resetting them, and listing
# enquiries. With this unset those routes return 503 rather than running
# unauthenticated — a missing token must not mean "no auth needed".
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Comma-separated origins allowed to call the API, or * for any.
# In production set this to the site's real origin.
CORS_ORIGINS=http://localhost:3000,https://ravinduyas.github.io

# Where the JSON store keeps prices.json and enquiries.json.
# Defaults to backend/data.
# DATA_DIR=/var/lib/mellow-bay
